# ── LiverCare Environment Variables ──────────────────────────
# Copy to .env and fill in values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livercaredb
DB_USER=livercare
DB_PASS=livercare_secret

# API Auth
ADMIN_USER=admin
ADMIN_PASS=livercare2024

# AI Engine
AI_ENGINE_URL=http://localhost:8000

# AWS — required for Bedrock (Claude 3 Sonnet)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_ENABLED=true

# Frontend
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_API_USER=admin
REACT_APP_API_PASS=livercare2024
